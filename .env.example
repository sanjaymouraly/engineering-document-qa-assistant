# Engineering Document Q&A Assistant — example configuration.
#
# Copy to `.env` (never commit the copy) or export the variables in your shell.
# Every name below is `ENGRAG_` + the matching field of
# src/engrag/config.py::Settings, and every value shown is the built-in default,
# so this file is also a safe reference for "what does the tool do if I set nothing?".
# The application runs fully offline with no .env at all.

# ---------------------------------------------------------------- storage
# Single SQLite file + uploads + page renders + exports live here.
ENGRAG_DATA_DIR=./data
ENGRAG_APP_NAME=Engineering RAG Assistant

# ---------------------------------------------------------------- servers
ENGRAG_HOST=0.0.0.0
ENGRAG_API_PORT=8502
ENGRAG_WEB_PORT=8501
# Set false when running behind a proxy that must not reach local services.
ENGRAG_ALLOW_PRIVATE_NETWORK_ENDPOINTS=true

# ---------------------------------------------------------------- upload / extraction limits
ENGRAG_MAX_UPLOAD_MB=60
ENGRAG_MAX_PAGES=1500
ENGRAG_MAX_EXTRACTED_CHARS_PER_DOC=6000000

# ---------------------------------------------------------------- chunking
ENGRAG_CHUNK_MIN_CHARS=400
ENGRAG_CHUNK_TARGET_CHARS=1500
ENGRAG_CHUNK_MAX_CHARS=2400
ENGRAG_CHUNK_OVERLAP_CHARS=160

# ---------------------------------------------------------------- retrieval
ENGRAG_DEFAULT_TOP_K=6
ENGRAG_MAX_TOP_K=20
ENGRAG_CANDIDATE_POOL=60
ENGRAG_RELEVANCE_THRESHOLD=0.02
# Below this composite evidence score the assistant abstains instead of answering.
ENGRAG_MIN_EVIDENCE_SCORE=0.10
# Semantic ranking is used only if a backend loads; otherwise a deterministic
# hashing n-gram embedder provides the vector signal.
ENGRAG_ENABLE_SEMANTIC=true
ENGRAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---------------------------------------------------------------- numeric verification
# Relative tolerance for value comparison. Default is effectively exact so no
# discrepancy is ever rounded away; max_rel_tolerance caps what a user may open.
ENGRAG_DEFAULT_REL_TOLERANCE=1e-9
ENGRAG_MAX_REL_TOLERANCE=0.05

# ---------------------------------------------------------------- LLM (all optional)
# offline = extractive answers, verbatim quotes, no external call. llm = use the
# provider saved in AI Settings (or the environment key below, once selected there).
ENGRAG_LLM_MODE=offline
ENGRAG_LLM_MAX_OUTPUT_TOKENS=900
ENGRAG_LLM_TIMEOUT_S=90
ENGRAG_LLM_MAX_RETRIES=2
# Soft warning threshold (USD) shown in the UI for paid providers. 0 disables it.
# This is a reminder, not a hard spend cap: the provider bills you, not this app.
ENGRAG_BUDGET_WARN_USD=0

# Paid-provider environment variables. A key found here is only *suggested* in
# AI Settings — the app will not call a paid endpoint until you select and save
# that provider, so an accidental export cannot start spending.
#OPENAI_API_KEY=
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_MODEL=
#ANTHROPIC_API_KEY=
#ANTHROPIC_MODEL=

# ---------------------------------------------------------------- UI / misc
ENGRAG_HISTORY_ENABLED=true
ENGRAG_MAX_HISTORY_ROWS=500
ENGRAG_PDF_RENDER_SCALE=1.6
ENGRAG_MAX_RENDER_PIXELS=22000000
ENGRAG_LOG_LEVEL=INFO
